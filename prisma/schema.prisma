generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
 
  
}

model item {
  id            Int      @id @default(autoincrement())
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  brandId         String?
  brand Brand? @relation(fields:[brandId] , references:[id])
  itemModelId String?
  itemModel brandModel? @relation(fields:[itemModelId] , references:[id])
  categoryName String?
  brandName String?
  modelName String?
  price         Float
  stock         Int
  image         Json
  discount      Float?
  discountType  String?
  createdAt     DateTime @default(now())
  @@index([name])
  @@index([price])
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  createdAt DateTime? @default(now())
  items item[]
  brand Brand[]
}
model Brand{
  id String @id @default(uuid())
  name String 
  categoryId String?
  category Category? @relation(fields: [categoryId] , references: [id])
  createdAt DateTime? @default(now())
  items item[]
  models brandModel[]
  
}
model brandModel{
  id String @id @default(uuid())
  name String
  brandId String?
  brand Brand? @relation(fields:[brandId] , references:[id])
  createdAt DateTime? @default(now())
  items item[]
}
model User{
  id String @id @default(uuid())
  email String @unique
  password String
  name String
  orders Subscriptions[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlackListedToken{
  id String @id @default(uuid())
  token String 
}

model Subscriptions{
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId] , references: [id])
  status String
  stripeSessionId String @default("Pending")
  amount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Customers{
  id String @id @default(uuid())
  name String
  email String 
  password String
  homeAddress String
  Country String
  State String
  City String
  phone String
  order Order[]
}

model Order{
  id String @id @default(uuid())
  userId String
  user Customers @relation(fields: [userId] , references: [id])
  customerData Json
  products Json
  amount Float
  paymentId String
  paymentStatus String
  orderStatus String
  createdAt DateTime @default(now())
}